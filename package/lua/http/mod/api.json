<?vlc
-- VLC Web UI Plus - extended JSON API endpoint
local common        = require "common"
local httprequests  = require "httprequests"

local R    = {}
local ERRS = {}
local function fail(m) ERRS[#ERRS+1] = tostring(m) end

-- pcall wrapper keeping the first return value
local function try(f, ...)
    local ok, a = pcall(f, ...)
    if not ok then fail(a); return nil end
    return a
end

local G = _G._GET or {}
local function arg(n, d) local v = G[n]; if v == nil or v == "" then return d end return v end
local function num(n, d) return tonumber(arg(n)) or d end

local function object(which)
    if which == "input"        then return vlc.object.input()
    elseif which == "aout"     then return vlc.object.aout()
    elseif which == "vout"     then return vlc.object.vout()
    elseif which == "playlist" then return vlc.object.playlist()
    elseif which == "libvlc"   then return vlc.object.libvlc() end
    return nil
end

-- coerce a query string value into the lua type VLC expects
local function coerce(v, t)
    if t == "int"   then return math.floor(tonumber(v) or 0) end
    if t == "float" then return common.us_tonumber(v) end
    if t == "bool"  then return (v == "1" or v == "true" or v == "yes") end
    return tostring(v)
end

-- {value,text} choice list for a variable, nil when unavailable
local function choices(o, name)
    if not o then return nil end
    local ok, vals, texts = pcall(vlc.var.get_list, o, name)
    if not ok or type(vals) ~= "table" then return nil end
    local out = { _array = {} }
    for i, v in ipairs(vals) do
        out._array[#out._array+1] = { value = v, text = tostring((texts and texts[i]) or v) }
    end
    return out
end

local function varget(o, name)
    if not o then return nil end
    local ok, v = pcall(vlc.var.get, o, name)
    if not ok then return nil end
    return v
end

local function cfgget(name)
    local ok, v = pcall(vlc.config.get, name)
    if not ok then return nil end
    return v
end

-- infer the wanted lua type from the value VLC currently holds
local function typeof_current(cur, explicit)
    if explicit then return explicit end
    if type(cur) == "boolean" then return "bool" end
    -- float is safe for int options too, VLC truncates on the way in
    if type(cur) == "number" then return "float" end
    return "string"
end

-- ---------------------------------------------------------------- paths
-- VLC hands back a mix of "C:\", "C:/x" and "~", normalise to forward slashes
local function normpath(p)
    if not p or p == "" then return "" end
    p = string.gsub(p, "\\", "/")
    local unc = string.match(p, "^//[^/]") ~= nil
    p = string.gsub(p, "//+", "/")
    if unc then p = "/" .. p end
    -- keep the slash only on roots: "/", "C:/", "//server/"
    if #p > 1 and string.sub(p, -1) == "/" and not string.match(p, "^%a:/$") then
        p = string.sub(p, 1, -2)
    end
    return p
end

local function isroot(p)
    return p == "" or p == "/" or string.match(p, "^%a:/$") ~= nil
end

local function joinpath(dir, name)
    if dir == "" then return name end
    if string.sub(dir, -1) == "/" then return dir .. name end
    return dir .. "/" .. name
end

local function parentof(p)
    if isroot(p) then return "" end
    local up = string.match(p, "^(.*)/[^/]+$")
    if not up or up == "" then
        -- "C:/Users" -> "C:/", "/usr" -> "/"
        if string.match(p, "^%a:/[^/]+$") then return string.sub(p, 1, 3) end
        return "/"
    end
    if string.match(up, "^%a:$") then return up .. "/" end
    return up
end

local MEDIA_EXT = {
    mp4=1, mkv=1, avi=1, mov=1, wmv=1, flv=1, webm=1, m4v=1, mpg=1, mpeg=1, ts=1, m2ts=1,
    vob=1, ogv=1, rmvb=1, divx=1, ["3gp"]=1, mts=1,
    mp3=1, flac=1, wav=1, ogg=1, oga=1, opus=1, m4a=1, aac=1, wma=1, ape=1, alac=1, aiff=1,
    mid=1, midi=1, dsf=1, mka=1, ac3=1, dts=1,
    jpg=1, jpeg=1, png=1, gif=1, bmp=1, webp=1, tiff=1,
    srt=1, ass=1, ssa=1, sub=1, idx=1, vtt=1, sup=1,
    m3u=1, m3u8=1, pls=1, xspf=1, cue=1, iso=1
}

-- make_uri mangles forward slashes on Windows, hand it native separators
local function nativepath(p)
    if string.match(p, "^%a:[/\\]") or string.match(p, "^[/\\][/\\]") then
        return (string.gsub(p, "/", "\\"))
    end
    return p
end

-- a scheme needs two or more letters, so "C://x" is never mistaken for one
local function isuri(u)
    return string.match(u, "^%a[%w+.-]+://") ~= nil
end

-- turn a plain path into a uri, leave real uris alone
local function touri(u)
    if not u or u == "" then return nil end
    if isuri(u) then return u end
    return vlc.strings.make_uri(nativepath(u)) or u
end

-- ---------------------------------------------------------------- commands
local cmd = arg("cmd")

-- stock httprequests commands keep working through this endpoint
if G["command"] then try(httprequests.processcommands) end

if cmd == "setvar" then
    local o = object(arg("obj", "input"))
    local name = arg("name")
    if o then
        local t = typeof_current(varget(o, name), G["type"])
        try(vlc.var.set, o, name, coerce(arg("val"), t))
    else
        fail("object not available: " .. tostring(arg("obj", "input")))
    end

elseif cmd == "setconfig" then
    local name = arg("name")
    try(vlc.config.set, name, coerce(arg("val"), typeof_current(cfgget(name), G["type"])))

elseif cmd == "setconfig_multi" then
    -- names=a,b,c with v_<name>=value and optional t_<name>=type
    for name in string.gmatch(arg("names", ""), "[^,]+") do
        local t = typeof_current(cfgget(name), G["t_" .. name])
        try(vlc.config.set, name, coerce(G["v_" .. name], t))
    end

elseif cmd == "key" then
    -- common.hotkey returns false for unknown actions instead of raising
    local name = "key-" .. tostring(arg("val"))
    local ok, res = pcall(common.hotkey, name)
    if not ok then fail(res)
    elseif res ~= true then fail("unknown action: " .. name) end

elseif cmd == "osd" then
    try(vlc.osd.message, tostring(arg("val", "")), nil, arg("pos", "top-right"), num("dur", 3) * 1000000)

elseif cmd == "seek" then
    try(common.seek, arg("val"))

elseif cmd == "volume" then
    try(common.volume, arg("val"))

elseif cmd == "aout_device" then
    local a = vlc.object.aout()
    if a then try(vlc.var.set, a, "device", tostring(arg("val")))
    else fail("no audio output active") end

elseif cmd == "eq_set" then
    if G["enable"] then try(vlc.equalizer.enable, arg("enable") ~= "0") end
    if G["preset"] then try(vlc.equalizer.setpreset, arg("preset")) end
    if G["preamp"] then try(vlc.equalizer.preampset, common.us_tonumber(arg("preamp"))) end
    for i = 0, 9 do
        local b = G["b" .. i]
        if b and b ~= "" then try(vlc.equalizer.equalizerset, i, common.us_tonumber(b)) end
    end

elseif cmd == "addsub" then
    -- add_subtitle takes a plain path, add_subtitle_mrl takes a uri
    local v = arg("val")
    local auto = (arg("select", "1") ~= "0")
    if not v then
        fail("no subtitle given")
    elseif isuri(v) then
        try(vlc.input.add_subtitle_mrl, v, auto)
    else
        try(vlc.input.add_subtitle, nativepath(v), auto)
    end

elseif cmd == "pl_add" then
    local uris = G["uri"]
    if type(uris) ~= "table" then uris = { uris } end
    local opts = {}
    for o in string.gmatch(arg("opts", ""), "[^:]+") do opts[#opts+1] = o end
    local items = {}
    for _, u in ipairs(uris) do
        local uri = touri(u)
        if uri then items[#items+1] = { path = uri, options = opts, name = arg("name") } end
    end
    if #items == 0 then
        fail("no uri given")
    elseif arg("play") == "1" then
        try(vlc.playlist.add, items)
    else
        try(vlc.playlist.enqueue, items)
    end

elseif cmd == "pl_move" then
    try(vlc.playlist.move, math.floor(num("id", -1)), math.floor(num("target", 0)))

elseif cmd == "pl_delete_many" then
    local ids = G["id"]
    if type(ids) ~= "table" then ids = { ids } end
    for _, i in ipairs(ids) do try(vlc.playlist.delete, math.floor(tonumber(i) or -1)) end

elseif cmd == "sd_toggle" then
    local v = arg("val")
    if vlc.sd.is_loaded(v) then try(vlc.sd.remove, v) else try(vlc.sd.add, v) end
end

-- ---------------------------------------------------------------- payloads
local want = {}
for w in string.gmatch(arg("want", "status"), "[^,]+") do want[w] = true end

local input, aout, vout = vlc.object.input(), vlc.object.aout(), vlc.object.vout()

if want["status"] then
    R.status = try(httprequests.getstatus, arg("info") == "1") or {}
    local x = {}
    x.hasinput = (input ~= nil)
    x.hasaout  = (aout ~= nil)
    x.hasvout  = (vout ~= nil)
    x.audio_es  = varget(input, "audio-es")
    x.video_es  = varget(input, "video-es")
    x.spu_es    = varget(input, "spu-es")
    x.program   = varget(input, "program")
    x.title     = varget(input, "title")
    x.chapter   = varget(input, "chapter")
    -- subtitle text scale is held on the playlist object, not the input
    x.sub_scale = varget(vlc.object.playlist(), "sub-text-scale")
    x.record    = varget(input, "record")
    x.can_seek  = varget(input, "can-seek")
    x.can_pause = varget(input, "can-pause")
    x.device    = varget(aout, "device")
    x.stereo    = varget(aout, "stereo-mode")
    x.mute      = varget(aout, "mute")
    x.visual       = varget(aout, "visual")
    x.audio_filter = varget(aout, "audio-filter")
    x.replaygain   = varget(aout, "audio-replay-gain-mode")
    x.crop      = varget(vout, "crop")
    x.zoom      = varget(vout, "zoom")
    x.deinterlace      = varget(vout, "deinterlace")
    x.deinterlace_mode = varget(vout, "deinterlace-mode")
    x.aspect       = varget(vout, "aspect-ratio")
    x.sub_source   = varget(vout, "sub-source")
    x.video_filter = varget(vout, "video-filter")
    R.ext = x
end

if want["caps"] then
    local c = {}
    c.audio_tracks = choices(input, "audio-es")
    c.video_tracks = choices(input, "video-es")
    c.sub_tracks   = choices(input, "spu-es")
    c.programs     = choices(input, "program")
    c.titles       = choices(input, "title")
    c.chapters     = choices(input, "chapter")
    c.devices      = choices(aout, "device")
    c.stereo_modes = choices(aout, "stereo-mode")
    c.visual       = choices(aout, "visual")
    c.replaygain   = choices(aout, "audio-replay-gain-mode")
    c.zoom         = choices(vout, "zoom")
    c.aspect       = choices(vout, "aspect-ratio")
    c.crop         = choices(vout, "crop")
    c.deinterlace_modes = choices(vout, "deinterlace-mode")
    c.sd = { _array = {} }
    local ok, names, longnames = pcall(vlc.sd.get_services_names)
    if ok and type(names) == "table" then
        for k, v in pairs(names) do
            local id, label
            if type(k) == "number" then id, label = v, (longnames and longnames[k]) or v
            else id, label = k, v end
            c.sd._array[#c.sd._array+1] = { value = id, text = tostring(label), loaded = vlc.sd.is_loaded(id) }
        end
    end
    R.caps = c
end

if want["keys"] then
    -- which hotkey actions this build knows, names given without the key- prefix
    local k = {}
    for n in string.gmatch(arg("names", ""), "[^,]+") do
        local ok, id = pcall(vlc.misc.action_id, "key-" .. n)
        k[n] = (ok and id ~= nil)
    end
    R.keys = k
end

if want["vars"] then
    -- generic probe: names=a,b,c on obj=input|aout|vout|playlist|libvlc
    local o = object(arg("obj", "input"))
    local v = {}
    for k in string.gmatch(arg("names", ""), "[^,]+") do
        v[k] = { value = varget(o, k), choices = choices(o, k) }
    end
    R.vars = v
end

if want["config"] then
    -- an unset string option reads back as nil, that is not the same as unknown
    local cfg, unknown = {}, {}
    for k in string.gmatch(arg("keys", ""), "[^,]+") do
        local ok, v = pcall(vlc.config.get, k)
        if ok then cfg[k] = (v == nil) and "" or v
        else unknown[#unknown+1] = k end
    end
    R.config = cfg
    R.config_unknown = { _array = unknown }
end

if want["now"] then
    -- compact "what is actually playing" summary, plus config sanity warnings
    local n = { warn = { _array = {} } }
    local function warn(m) n.warn._array[#n.warn._array+1] = m end

    -- info keys are translated by VLC, so match on the shape of the value instead
    local function looks_channels(v)
        local s = string.lower(v)
        if string.match(s, "^%d%.%d$") then return true end
        return string.match(s, "stereo") or string.match(s, "mono") or string.match(s, "dual")
            or string.match(s, "surround") or string.match(s, "dolby")
            or string.match(s, "%df%d?r") or string.match(s, "lfe") or false
    end

    -- VLC uses spaces in some info keys, normalise before looking anything up
    local function norm(kv)
        local t = {}
        for k, v in pairs(kv) do t[(string.gsub(k, "%s", "_"))] = v end
        return t
    end

    local item = input and vlc.input.item()
    local info = item and item:info() or {}
    local vcat, acat
    for name, raw in pairs(info) do
        if name ~= "meta" then
            local kv = norm(raw)
            -- only the audio stream reports decoded channels, only video has WxH
            if kv["Decoded_channels"] ~= nil then
                if not acat then acat = kv end
            elseif not vcat then
                for _, v in pairs(kv) do
                    if string.match(tostring(v), "^%d+x%d+$") then vcat = kv; break end
                end
            end
        end
    end

    if vcat then
        local dims, fps = {}, nil
        for k, v in pairs(vcat) do
            v = tostring(v)
            if string.match(v, "^%d+x%d+$") then dims[#dims+1] = v
            elseif string.match(v, "^%d+%.?%d*$") and tonumber(v) and tonumber(v) >= 1
                   and tonumber(v) <= 1000 and not fps then fps = v end
        end
        -- smallest frame wins: the other entry is the padded decoder buffer
        table.sort(dims, function(a, b)
            local aw, ah = string.match(a, "(%d+)x(%d+)")
            local bw, bh = string.match(b, "(%d+)x(%d+)")
            return (aw * ah) < (bw * bh)
        end)
        n.video = { res = dims[1], fps = fps }
        if dims[2] and dims[2] ~= dims[1] then
            local w1, h1 = string.match(dims[1], "(%d+)x(%d+)")
            local w2, h2 = string.match(dims[2], "(%d+)x(%d+)")
            -- ignore a few pixels of macroblock padding, report a real difference
            if (w2 - w1) > 16 or (h2 - h1) > 16 then n.video.display = dims[2] end
        end
    end

    if acat then
        local a = { decoded = acat["Decoded_channels"] }
        for k, v in pairs(acat) do
            v = tostring(v)
            if string.match(v, "%d+%s*Hz$") then a.rate = v
            elseif string.match(v, "kb/s") then a.bitrate = v
            elseif k ~= "Decoded_channels" and looks_channels(v) then a.channels = v end
        end
        a.channels = a.channels or a.decoded
        n.audio = a
    end

    -- name of the selected track, taken from the choice list
    local function label(o, var)
        local cur = varget(o, var)
        if cur == nil then return nil, nil end
        local ok, vals, texts = pcall(vlc.var.get_list, o, var)
        if ok and type(vals) == "table" then
            for i, v in ipairs(vals) do
                if v == cur then return tostring((texts and texts[i]) or v), cur end
            end
        end
        return nil, cur
    end

    n.atrack, n.audio_es = label(input, "audio-es")
    n.strack, n.spu_es   = label(input, "spu-es")
    n.subs_on = (n.spu_es ~= nil and n.spu_es >= 0)
    n.stereo_text, n.stereo = label(aout, "stereo-mode")
    n.aspect  = varget(vout, "aspect-ratio")
    n.crop    = varget(vout, "crop")
    n.filters = varget(aout, "audio-filter")
    n.force_dolby = cfgget("force-dolby-surround")
    n.spdif = cfgget("spdif")

    -- how many channels a layout string carries, 0 when unreadable
    local function chcount(s)
        s = string.lower(tostring(s or ""))
        if s == "" then return 0 end
        if string.find(s, "7.1", 1, true) or string.find(s, "3f4r", 1, true) then return 8 end
        if string.find(s, "6.1", 1, true) then return 7 end
        if string.find(s, "5.1", 1, true) or string.find(s, "3f2r", 1, true) then return 6 end
        if string.find(s, "5.0", 1, true) or string.find(s, "3f2m", 1, true) then return 5 end
        if string.find(s, "4.0", 1, true) or string.find(s, "quad", 1, true) then return 4 end
        if string.find(s, "3.0", 1, true) then return 3 end
        if string.find(s, "stereo", 1, true) or string.find(s, "2.0", 1, true) then return 2 end
        if string.find(s, "mono", 1, true) or string.find(s, "1.0", 1, true) then return 1 end
        return 0
    end

    local src = chcount(n.audio and n.audio.channels)
    local dec = chcount(n.audio and n.audio.decoded)
    n.src_channels = src
    n.dec_channels = dec
    n.surround = (src >= 5)

    local FORCED = { [1]="stereo", [2]="reversed stereo", [3]="left only", [4]="right only",
                     [5]="Dolby surround", [6]="mono", [7]="headphones" }
    local forced = FORCED[n.stereo]
    n.downmixed = (src >= 5 and dec > 0 and dec < src)

    if n.downmixed then
        warn(n.audio.channels .. " audio is reaching the speakers as " .. n.audio.decoded ..
             " — VLC is downmixing it.")
    end
    if src >= 5 and forced and n.stereo ~= 5 and n.stereo ~= 7 then
        warn("Stereo mode is forced to " .. forced .. ". Set it to Unset on the Audio tab for surround.")
    end
    local flt = string.lower(tostring(n.filters or ""))
    if src >= 5 and string.find(flt, "mono", 1, true) then
        warn("The 'mono' audio filter is loaded, surround is collapsed to one channel.")
    end
    if src >= 5 and string.find(flt, "headphone", 1, true) then
        warn("Headphone virtualisation is on. Right for headphones, wrong for speakers.")
    end
    if src > 0 and src <= 2 and n.stereo == 5 then
        warn("Dolby surround decoding is forced on a " .. (src == 1 and "mono" or "stereo") .. " track.")
    end
    if src > 0 and src <= 2 and tonumber(n.force_dolby or 0) == 1 then
        warn("force-dolby-surround is On in preferences but this track is not surround.")
    end
    if input ~= nil and aout == nil then
        warn("No audio output is open — nothing is being sent to the speakers.")
    end
    if n.spdif == true and src >= 5 then
        warn("S/PDIF passthrough is on, so your receiver picks the surround mode, not VLC.")
    end

    R.now = n
end

if want["playlist"] then R.playlist = try(httprequests.playlisttable) end

if want["browse"] then
    -- read raw: an empty path means "list the drives", not "use the default"
    local p = G["path"]
    if p == nil then p = G["dir"] end
    if p == nil then p = "~" end
    if p == "~" then p = vlc.config.homedir() end
    p = normpath(p)

    local b = { path = p, parent = parentof(p), entries = { _array = {} }, crumbs = { _array = {} } }

    -- breadcrumb, "" is the drive/root listing
    b.crumbs._array[1] = { name = "Computer", path = "" }
    if p ~= "" then
        local acc = ""
        local first = true
        for part in string.gmatch(p, "[^/]+") do
            if first and string.match(part, "^%a:$") then acc = part .. "/"
            elseif first then acc = "/" .. part
            else acc = joinpath(acc, part) end
            first = false
            b.crumbs._array[#b.crumbs._array+1] = { name = part, path = acc }
        end
        if string.sub(p, 1, 1) == "/" and #b.crumbs._array == 1 then
            b.crumbs._array[2] = { name = "/", path = "/" }
        end
    end

    local mediaonly = (arg("show") == "media")
    local listdir = p
    if p ~= "" and string.sub(listdir, -1) ~= "/" then listdir = listdir .. "/" end

    local ok, d = pcall(vlc.net.opendir, listdir)
    if not ok or type(d) ~= "table" then
        fail("cannot open: " .. p)
        d = {}
    end
    table.sort(d)

    for _, f in ipairs(d) do
        if f ~= "." and f ~= ".." and not string.match(f, "^%.") then
            local child = normpath(joinpath(p, f))
            local s = vlc.net.stat(child)
            local kind = s and s.type or "unknown"
            if p == "" then kind = "dir" end   -- drive letters do not stat
            local ext = string.lower(string.match(f, "%.([^%.]+)$") or "")
            local keep = (kind == "dir") or (not mediaonly) or MEDIA_EXT[ext]
            if keep then
                local e = { name = f, path = child, type = kind, ext = ext }
                if p == "" then e.name = (string.gsub(f, "[\\/]+$", "")) end
                if s then e.size = s.size; e.mtime = s.modification_time end
                if kind ~= "dir" then e.uri = vlc.strings.make_uri(nativepath(child)) end
                b.entries._array[#b.entries._array+1] = e
            end
        end
    end

    -- directories first, then plain alphabetical
    table.sort(b.entries._array, function(x, y)
        local dx, dy = (x.type == "dir"), (y.type == "dir")
        if dx ~= dy then return dx end
        return string.lower(x.name) < string.lower(y.name)
    end)

    R.browse = b
end

R.errors = { _array = ERRS }
R.ok = (#ERRS == 0)
httprequests.printTableAsJson(R)
?>
